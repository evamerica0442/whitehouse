{
  "name": "@whitehouse/aws-sdk-wrapper",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-account AWS client helpers: STS AssumeRole, scoped client factories, CFN onboarding templates, CloudProvider drivers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsc -b tsconfig.json --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1140.0",
    "@aws-sdk/client-cost-explorer": "^3.1140.0",
    "@aws-sdk/client-organizations": "^3.1140.0",
    "@aws-sdk/client-sts": "^3.1140.0",
    "@aws-sdk/credential-providers": "^3.1140.0",
    "@whitehouse/shared": "*",
    "zod": "^4.6.5"
  }
}
