# =============================================================================
# Whitehouse Cloudguard — environment contract
#
# Copy to `.env` at the repository root and fill in. Every value is read through
# apps/api/src/config/env.ts at boot, so a missing or malformed value fails fast
# with a readable error instead of surfacing later as a confusing runtime bug.
#
# Nothing in this file is host-specific: the same variables work on a laptop, on
# Render + Vercel, and later on ECS + RDS.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ---- Public URLs ------------------------------------------------------------
# APP_BASE_URL is used to build magic-link URLs and as the default CORS origin.
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
# Comma-separated. In production: the Vercel URL, e.g. https://cloudguard.vercel.app
CORS_ORIGINS=http://localhost:5173

# ---- Database (Neon) --------------------------------------------------------
# Pooled connection (has "-pooler" in the host) — used by the application.
# connect_timeout is important: Neon suspends idle computes and takes a few
# seconds to wake, which otherwise surfaces as Prisma P1001.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/whitehouse?sslmode=require&connect_timeout=15&connection_limit=5"
# Direct (unpooled) connection — used by `prisma migrate` / `db push` only,
# because DDL over a PgBouncer transaction pool is unreliable.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/whitehouse?sslmode=require&connect_timeout=15"

# ---- Auth -------------------------------------------------------------------
# 32+ characters. Hashes session and magic-link tokens (HMAC), so rotating this
# value invalidates every existing session and magic link.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=wh_session
SESSION_TTL_HOURS=12
MAGIC_LINK_TTL_MINUTES=20
# The web app and API live on different hosts on the free tier, which makes the
# session cookie cross-site: set SESSION_COOKIE_SAME_SITE=none with
# SESSION_COOKIE_SECURE=true in production. Use lax/false locally over http.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# ---- Transactional email ----------------------------------------------------
# console = log instead of sending (default, safe locally). resend = real email.
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM="Whitehouse Cloudguard <onboarding@resend.dev>"

# ---- Cloud provider ---------------------------------------------------------
# mock = deterministic fixtures, no AWS credentials needed (works on the free
# tier and in CI). aws = live STS AssumeRole + Cost Explorer calls.
CLOUD_PROVIDER=mock
AWS_REGION=us-east-1
# The MSP management account. Required for CLOUD_PROVIDER=aws, and required to
# generate onboarding templates (it is the principal in the customer trust policy).
AWS_MANAGEMENT_ACCOUNT_ID=
# Only for local development. On Render/ECS, use the platform-provided identity
# (or an IAM role) rather than long-lived keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- Jobs -------------------------------------------------------------------
# pg-boss (durable, Postgres-backed) or memory (tests / no database).
JOB_DRIVER=pg-boss
JOB_CONCURRENCY=2
# Shared secret for the GitHub Actions scheduler calling
# POST /api/v1/internal/jobs/run-daily. Leave empty to disable that endpoint.
INTERNAL_CRON_SECRET=

# ---- Web (Vite — must be prefixed with VITE_) -------------------------------
# Leave empty in development so requests go through the Vite proxy on the same
# origin. In production set the full API origin, e.g. https://wh-api.onrender.com
VITE_API_BASE_URL=
