{
  "name": "@whitehouse/api",
  "version": "0.1.0",
  "private": true,
  "description": "Whitehouse Cloudguard API — Fastify server + in-process job worker",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -b tsconfig.json",
    "user:password": "npm --prefix ../.. run build:packages && tsx src/scripts/set-password.ts",
    "user:create": "npm --prefix ../.. run build:packages && tsx src/scripts/create-user.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.1140.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@whitehouse/aws-sdk-wrapper": "*",
    "@whitehouse/db": "*",
    "@whitehouse/shared": "*",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.29.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15"
  }
}
